# ============================================================
# Copy this file to `.env` and fill in your Azure AD / Power BI values.
# These are SERVER-ONLY secrets — never expose them to the browser.
# ============================================================

# Azure AD tenant (directory) id
TENANT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Service principal (app registration) client id
CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Service principal client secret (value, not the secret id)
CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated origins allowed to call this API (the Angular dev server)
ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200
